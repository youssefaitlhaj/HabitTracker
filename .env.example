# Firebase (recommended): Firebase console › Project settings › Your apps › Web app › SDK config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Reminder notifications: public VAPID key (npx web-push generate-vapid-keys). The private key
# only goes into the GitHub Actions secrets, never here.
VITE_VAPID_PUBLIC_KEY=

# Supabase (alternative). Used only when the Firebase keys above are empty.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave everything empty to run Ledger in local demo mode (data stays in this browser).
