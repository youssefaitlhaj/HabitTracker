rules_version = '2';

// Ledger: each person can only read and write their own data (design §8.1).
// Paste this into Firebase console › Firestore Database › Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isConfirmedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    // Admins are added by hand: Firestore › admins › document whose id is the admin's user UID.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Lets the app ask "am I an admin?". Nobody can add or change admins from the app.
    match /admins/{uid} {
      allow get: if isOwner(uid);
    }

    // Feedback from demo visitors, who have no account: anyone may add one entry with only
    // the text (1–1000 characters), the server's time and notified = false. Only admins read it;
    // nobody can change or delete it from the app (the reminder job sets notified with its own key).
    match /demoFeedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'createdAt', 'notified'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.notified == false;
      allow read: if isAdmin();
    }

    match /users/{uid} {
      // The profile is created during sign-up, before the email is confirmed.
      allow create: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow read, update, delete: if isConfirmedOwner(uid);

      // Browsers that receive reminder notifications (written by the app, read by the reminder job).
      match /devices/{deviceId} {
        allow read, write: if isConfirmedOwner(uid);
      }

      // Daily tasks, grouped per month (document id YYYY-MM).
      // `list` can't check the id (a list has no single id), so it only checks ownership.
      match /taskMonths/{month} {
        allow list: if isConfirmedOwner(uid);
        allow get, write: if isConfirmedOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$');
      }

      match /habits/{habitId} {
        allow read, delete: if isConfirmedOwner(uid);
        allow create, update: if isConfirmedOwner(uid)
          && request.resource.data.id == habitId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }
    }
  }
}
