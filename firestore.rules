rules_version = '2';

// Ledger: each person can only read and write their own data (design §8.1).
// Paste this into Firebase console › Firestore Database › Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isConfirmedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      // The profile is created during sign-up, before the email is confirmed.
      allow create: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow read, update, delete: if isConfirmedOwner(uid);

      // Browsers that receive reminder notifications (written by the app, read by the reminder job).
      match /devices/{deviceId} {
        allow read, write: if isConfirmedOwner(uid);
      }

      // Daily tasks, grouped per month (document id YYYY-MM).
      match /taskMonths/{month} {
        allow read, write: if isConfirmedOwner(uid) && month.matches('^[0-9]{4}-[0-9]{2}$');
      }

      match /habits/{habitId} {
        allow read, delete: if isConfirmedOwner(uid);
        allow create, update: if isConfirmedOwner(uid)
          && request.resource.data.id == habitId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }
    }
  }
}
